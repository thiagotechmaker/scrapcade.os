#!/bin/sh
# Modo jogo do ScrapCade: abre o ScrapCade em tela cheia no tty1.
# O login de manutencao fica no tty2 (Ctrl+Alt+F2).
export SDL_VIDEODRIVER=kmsdrm
export XDG_RUNTIME_DIR=/run/pipewire PIPEWIRE_RUNTIME_DIR=/run/pipewire   # som pelo PipeWire (S35pipewire)
# controles: banco da comunidade (SDL_GameControllerDB) + os que o usuario configurou no ScrapCade.
# O ScrapCade e o RetroArch leem o mesmo arquivo.
mkdir -p /userdata/system/configs
cat /usr/share/scrapcade/gamecontrollerdb.txt /userdata/system/configs/controles.txt > /tmp/gamecontrollerdb.txt 2>/dev/null
export SDL_GAMECONTROLLERCONFIG_FILE=/tmp/gamecontrollerdb.txt
# volume salvo no painel Sistema
[ -f /userdata/system/configs/volume ] && amixer -q sset Master "$(cat /userdata/system/configs/volume)" 2>/dev/null
# "Iniciar em modo de compatibilidade" no menu de boot: desenha sem a aceleracao da placa de video
if grep -q "tos.seguro=1" /proc/cmdline; then
  export LIBGL_ALWAYS_SOFTWARE=1 SDL_RENDER_DRIVER=software
fi
# fuso escolhido no painel (Brasilia de fabrica, pelo /etc/localtime)
[ -s /userdata/system/configs/fuso ] && export TZ="$(cat /userdata/system/configs/fuso)"
DAEMON=/usr/bin/scrapcade
PIDFILE=/var/run/scrapcade.pid
LOG=/userdata/system/logs/scrapcade.log
case "$1" in
  start)
    printf "Starting scrapcade: "
    mkdir -p "${LOG%/*}"
    /usr/bin/tos-carregando 30     # logo + CARREGANDO ate o menu desenhar (o menu encerra a animacao)
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh -- -c "exec $DAEMON >>$LOG 2>&1" && echo "OK" || echo "FAIL"
    ;;
  stop)
    printf "Stopping scrapcade: "
    start-stop-daemon -K -q -p "$PIDFILE" && echo "OK" || echo "FAIL"
    rm -f "$PIDFILE"
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
esac
exit 0
