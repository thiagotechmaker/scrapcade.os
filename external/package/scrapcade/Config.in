config BR2_PACKAGE_SCRAPCADE
	bool "scrapcade"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_TTF
	select BR2_PACKAGE_SDL2_IMAGE
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_DEJAVU
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  ScrapCade: menu de jogos do ScrapCade (modo jogo), em C++ com SDL2.
	  Mesmo visual do ScrapCade do iChroma: dados dos jogos pelo CRC,
	  capas do acervo libretro e organizacao da pasta "Jogos novos".
