# --- Bluetooth: controles sem fio (PS4, PS5, Switch, Xbox, 8BitDo) e fones
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_INTEL=m
CONFIG_BT_BCM=m
CONFIG_BT_RTL=m
CONFIG_BT_MTK=m
CONFIG_BT_ATH3K=m
CONFIG_UHID=y
CONFIG_HID_GENERIC=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
# --- achar o pen drive e o disco em notebooks mais novos (sem isso o initrd fica "procurando o sistema"):
# portas USB-C/USB4 (Thunderbolt), leitores de cartao Realtek, SD por ACPI, Intel VMD (SSD NVMe atras do VMD),
# controladores xHCI da Renesas (placas USB 3.0 antigas) e da plataforma, IDE/SATA antigo (PIIX)
CONFIG_USB4=y
CONFIG_TYPEC=y
CONFIG_USB_XHCI_PCI_RENESAS=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MISC_RTSX_USB=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_MMC_REALTEK_USB=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_VMD=y
CONFIG_ATA_PIIX=y
# --- logo do ScrapCade OS enquanto o sistema liga (a imagem entra pelo external.mk)
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
# sem as mensagens do descompactador do kernel no inicio (a tela fica so com a logo)
# CONFIG_X86_VERBOSE_BOOTUP is not set
# --- PortMaster: o gptokeyb transforma o controle em teclado/mouse para os ports (precisa do uinput)
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
