#!/bin/busybox sh
# ScrapCade: acha o tos.squashfs (pen drive, HD, DVD ou .iso), monta ele somente leitura com uma camada
# na memoria por cima, e passa para o sistema. Desligar da tomada nao estraga o sistema.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo 0 > /proc/sys/kernel/printk
mkdir -p /boot /lower /rw /newroot

# logo do ScrapCade OS na tela grafica (UEFI ou VESA da BIOS) enquanto o sistema liga. O Linux nao mostra a
# logo dele quando o boot e silencioso (quiet); entao o initrd desenha a nossa direto em /dev/fb0, animada como a
# do iChroma: as letras aparecem uma a uma e uma barra de blocos corre embaixo ate o sistema assumir a tela.
# A animacao roda em segundo plano (nao atrasa a procura do disco); ao sair do initrd, a logo fica inteira.
ANIM=""; lw=480; lh=64
tela() {   # geometria da tela e onde a logo fica
  f=/sys/class/graphics/fb0
  [ -c /dev/fb0 ] && [ -r $f/bits_per_pixel ] || return 1
  bpp=$(cat $f/bits_per_pixel); [ -f /logo$bpp.raw ] || return 1
  m=$(head -1 $f/modes 2>/dev/null | sed -n 's/.*:\([0-9]*\)x\([0-9]*\).*/\1 \2/p')
  [ -n "$m" ] || m=$(tr ',' ' ' < $f/virtual_size)
  set -- $m; w=$1; h=$2; st=$(cat $f/stride); bypp=$((bpp / 8))
  [ "$w" -ge $lw ] && [ "$h" -ge $lh ] || return 1
  x0=$(( (w - lw) / 2 )); y0=$(( (h - lh) * 2 / 5 ))
}
pinta() {   # arquivo, byte inicial, bytes por linha, linhas, bytes entre linhas no arquivo, x e y na tela
  i=0
  while [ $i -lt $4 ]; do
    dd if=$1 of=/dev/fb0 bs=$3 count=1 skip=$(($2 + i * $5)) seek=$(( ($7 + i) * st + $6 * bypp )) \
       iflag=skip_bytes oflag=seek_bytes conv=notrunc 2>/dev/null
    i=$((i + 1))
  done
}
logo_inteira() { pinta /logo$bpp.raw 0 $((lw * bypp)) $lh $((lw * bypp)) $x0 $y0; }
anima() {
  # as letras (colunas de cada uma na logo de 480 px, o selo OS por ultimo)
  for l in 4:42 50:88 97:134 143:181 190:227 236:274 282:320 329:366 375:413 422:475; do
    a=${l%:*}; b=${l#*:}
    pinta /logo$bpp.raw $((a * bypp)) $(( (b - a + 1) * bypp )) $lh $((lw * bypp)) $((x0 + a)) $y0
    sleep 0.05
  done
  # a barra: 12 blocos de 34 x 10 (barra*.raw: 0 apagado, 1 a cabeca, 2 a 4 o rastro); so os que mudam sao redesenhados
  bw=34; bh=10; bx=$((x0 + 3)); by=$((y0 + lh + 26)); B=/barra$bpp.raw
  [ -f $B ] && [ $((by + bh)) -le "$h" ] || return 0
  k=0; while [ $k -lt 12 ]; do pinta $B 0 $((bw * bypp)) $bh $((bw * bypp)) $((bx + k * 40)) $by; k=$((k + 1)); done
  c=0
  while :; do
    k=0
    while [ $k -lt 12 ]; do
      d=$(( (c - k + 12) % 12 ))      # distancia ate a cabeca: 0 a 3 acesos, 4 apaga (o rastro anda)
      if [ $d -lt 5 ]; then
        cor=0; [ $d -lt 4 ] && cor=$((d + 1))
        pinta $B $((cor * bh * bw * bypp)) $((bw * bypp)) $bh $((bw * bypp)) $((bx + k * 40)) $by
      fi
      k=$((k + 1))
    done
    c=$(( (c + 1) % 12 )); sleep 0.1
  done
}
para_logo() { [ -n "$ANIM" ] && { kill $ANIM 2>/dev/null; wait $ANIM 2>/dev/null; ANIM=""; logo_inteira; }; }
if ! grep -q "loglevel=7" /proc/cmdline && tela; then
  printf '\033[2J\033[H' > /dev/tty1 2>/dev/null
  anima & ANIM=$!
fi

achou=""
# O GRUB diz de qual particao ele mesmo veio (tos.uuid=): usa essa, para o pen drive escolhido na BIOS/UEFI
# nao ligar a instalacao do HD. Sem tos.uuid (menu syslinux, que so existe nos pen drives): prefere USB.
UUID=""
for a in $(cat /proc/cmdline); do case "$a" in tos.uuid=*) UUID=$(echo "${a#tos.uuid=}" | tr a-z A-Z) ;; esac; done
uuid_de() { blkid "$1" 2>/dev/null | sed -n 's/.* UUID="\([^"]*\)".*/\1/p' | tr a-z A-Z; }
e_usb() { readlink -f "/sys/class/block/${1##*/}" 2>/dev/null | grep -q /usb; }
tenta() {
  mount -o ro "$1" /boot 2>/dev/null || return 1
  [ -f /boot/boot/tos.squashfs ] && return 0
  umount /boot; return 1
}
for t in $(seq 1 120); do      # ate 60 s: pen drive USB e leitor de cartao podem demorar a aparecer
  lista=""
  for d in /dev/sd* /dev/nvme*n* /dev/mmcblk* /dev/vd* /dev/sr*; do [ -b "$d" ] && lista="$lista $d"; done
  if [ -n "$UUID" ]; then
    for d in $lista; do [ "$(uuid_de $d)" = "$UUID" ] && tenta $d && { achou=$d; break 2; }; done
    [ $t -lt 20 ] && { sleep 0.5; continue; }   # 10 s esperando o disco certo; depois aceita outro
  fi
  for d in $lista; do e_usb $d && tenta $d && { achou=$d; break 2; }; done
  if [ $t -ge 16 ] || [ -n "$UUID" ]; then        # 8 s sem achar em USB: DVD e os outros discos
    for d in $lista; do case $d in /dev/sr*) tenta $d && { achou=$d; break 2; } ;; esac; done
    for d in $lista; do e_usb $d || { tenta $d && { achou=$d; break 2; }; }; done
  fi
  [ $t = 6 ] && echo "ScrapCade OS: procurando o sistema no pen drive..."
  [ $((t % 20)) = 0 ] && echo "  discos encontrados ate agora:${lista:- nenhum}"
  sleep 0.5
done
if [ -z "$achou" ]; then
  echo
  echo "ScrapCade OS: nao achei o sistema (boot/tos.squashfs) em nenhum disco."
  echo "  Discos que apareceram:${lista:- nenhum}"
  echo "  - Tire o pen drive e coloque em outra porta USB (de preferencia uma USB 2.0, preta) e ligue de novo."
  echo "  - Se ligou pela UEFI, tente pela BIOS antiga (Legacy/CSM) no menu de boot, ou o contrario."
  echo "  - Se nenhum disco apareceu, avise com o modelo do notebook: falta o controlador dele."
  [ -n "$ANIM" ] && kill $ANIM 2>/dev/null
  exec sh
fi
echo "$achou" > /dev/null   # (a tela fica so com a logo; o disco escolhido vai para /run-tos-boot)

# .iso gravado num pen drive (Rufus modo DD ou modo ISO, balenaEtcher): no primeiro boot o ScrapCade se copia
# para a memoria e o sistema (S00dados + tos-instalar) arruma o pen drive no formato definitivo:
# SCRAPCADE (sistema) + SCRAP-DADOS (jogos, sem limite de 4 GB). DVD e "tos.vivo" no menu: so roda, sem mexer.
conv=""
fs=$(awk '$2 == "/boot" {print $3}' /proc/mounts)
case "$achou" in /dev/sr*) ;; *)
  if ! grep -q "tos.vivo" /proc/cmdline && { [ "$fs" = iso9660 ] ||
       { [ "$fs" = vfat ] && [ -d /boot/isolinux ] && [ ! -e /boot/tos-dados ]; }; }; then
    p=${achou##*/}; disco=$p
    [ -e /sys/class/block/$p/partition ] && disco=$(basename "$(readlink -f /sys/class/block/$p/..)")
    mem=$(awk '/^MemTotal/ {print $2}' /proc/meminfo)
    tam=$(cat /sys/class/block/$disco/size 2>/dev/null)
    if [ "${mem:-0}" -ge 1500000 ] && [ "${tam:-0}" -ge 4194304 ]; then   # 1,5 GB de memoria, pen drive de 2 GB
      echo "ScrapCade: primeiro boot pelo .iso: copiando o sistema para a memoria (o pen drive vai ser arrumado)..."
      mkdir -p /copia
      mount -t tmpfs -o size=90% tmpfs /copia
      if cp -a /boot/. /copia/ 2>/dev/null; then
        umount /boot && mount --move /copia /boot && conv=/dev/$disco
      else
        umount /copia
      fi
    fi
  fi ;;
esac

# atualizacao A/B: "tos.sistema=" no menu de boot escolhe o arquivo (versao anterior)
SIS=tos.squashfs
for a in $(cat /proc/cmdline); do case "$a" in tos.sistema=*) SIS=${a#tos.sistema=} ;; esac; done
# versao nova ainda em teste: conta as tentativas; na terceira sem chegar ao ScrapCade, volta para a anterior
if [ "$SIS" = tos.squashfs ] && [ -f /boot/boot/tos-testando ] && [ -f /boot/boot/tos-anterior.squashfs ]; then
  mount -o remount,rw /boot 2>/dev/null
  n=$(cat /boot/boot/tos-testando 2>/dev/null); n=$((${n:-0} + 1))
  if [ "$n" -ge 3 ]; then
    echo "ScrapCade: a versao nova nao ligou 3 vezes; voltando para a anterior."
    cd /boot/boot
    mv tos.squashfs tos-com-problema.squashfs
    mv tos-anterior.squashfs tos.squashfs
    [ -f bzImage-anterior ] && mv bzImage bzImage-com-problema && mv bzImage-anterior bzImage
    [ -f initrd-anterior.gz ] && mv initrd.gz initrd-com-problema.gz && mv initrd-anterior.gz initrd.gz
    rm -f tos-testando
    cd /
    sync
    mount -o remount,ro /boot 2>/dev/null
    echo b > /proc/sysrq-trigger 2>/dev/null || reboot -f
  fi
  echo "$n" > /boot/boot/tos-testando
  sync
  mount -o remount,ro /boot 2>/dev/null
fi
[ -f "/boot/boot/$SIS" ] || SIS=tos.squashfs
mount -t squashfs -o ro "/boot/boot/$SIS" /lower
mount -t tmpfs -o mode=755 tmpfs /rw
mkdir -p /rw/upper /rw/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/rw/upper,workdir=/rw/work /newroot
mkdir -p /newroot/boot
mount --move /boot /newroot/boot
echo "$achou" > /newroot/run-tos-boot 2>/dev/null || true
[ -n "$conv" ] && echo "$conv" > /newroot/run-tos-converter
para_logo        # a animacao usa /dev/fb0: para antes de passar o /dev para o sistema (a logo fica inteira)
mount --move /dev /newroot/dev
umount /proc /sys
exec switch_root /newroot /sbin/init
