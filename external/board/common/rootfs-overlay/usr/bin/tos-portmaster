#!/bin/bash
# ScrapCade OS: abre o PortMaster (loja de ports de jogos, licenca MIT, github.com/PortsMaster/PortMaster-GUI).
# Na primeira vez baixa a versao oficial do GitHub (conferida pelo MD5 publicado) para SCRAP-DADOS/roms/ports;
# depois o proprio PortMaster se atualiza. Chamado pelo "PortMaster" do console Ports (via tos-jogar).
PM=/roms/ports/PortMaster
LOG=/userdata/system/logs/portmaster.log
BASE=https://github.com/PortsMaster/PortMaster-GUI/releases/latest/download
msg() { printf '%s\n' "$1" > /dev/tty1; echo "$1" >> "$LOG"; }
mkdir -p /userdata/system/logs /roms/ports
printf '\033c' > /dev/tty1

if [ ! -f "$PM/pugwash" ] || [ ! -f "$PM/utils/pm_launch.txt" ]; then
  msg "ScrapCade OS: baixando o PortMaster (so na primeira vez, uns 25 MB)..."
  T=/userdata/system/tmp-portmaster
  rm -rf "$T"; mkdir -p "$T"
  if curl -fsSL -m 900 -o "$T/PortMaster.zip" "$BASE/PortMaster.zip" &&
     curl -fsSL -m 60 -o "$T/PortMaster.zip.md5" "$BASE/PortMaster.zip.md5" &&
     [ "$(md5sum < "$T/PortMaster.zip" | cut -c1-32)" = "$(tr -d ' \n' < "$T/PortMaster.zip.md5" | cut -c1-32)" ]; then
    msg "Instalando..."
    (cd /roms/ports && unzip -oq "$T/PortMaster.zip") >> "$LOG" 2>&1
  else
    msg "Nao deu para baixar o PortMaster. Confira a internet em Sistema > Rede e Wi-Fi e tente de novo."
    rm -rf "$T"; sleep 8; exit 1
  fi
  rm -rf "$T"
fi

# ajustes do ScrapCade OS, refeitos a cada vez (o PortMaster se atualiza e pode trocar estes arquivos)
cp /usr/share/tos/portmaster/control.txt "$PM/control.txt"
chmod -R +x "$PM" 2>/dev/null
echo "== $(date '+%d/%m %H:%M') PortMaster" >> "$LOG"
cd "$PM" && bash ./PortMaster.sh >> "$LOG" 2>&1
printf '\033c' > /dev/tty1
