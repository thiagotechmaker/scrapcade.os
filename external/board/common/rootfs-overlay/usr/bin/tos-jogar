#!/bin/sh
# ScrapCade: abre o jogo no emulador certo, com a configuracao central, e volta para o ScrapCade.
# Uso: tos-jogar <console> <arquivo do jogo>
export HOME=/userdata/system   # historico e favoritos do RetroArch ficam em SCRAP-DADOS
SIS=$1
ROM=$2
CFG=/userdata/system/configs/retroarch
mkdir -p "$CFG" "/userdata/saves/$SIS" /userdata/bios /userdata/screenshots /userdata/system/logs

# Ports (PortMaster): o "jogo" e um script bash; roda ele e volta para o ScrapCade
if [ "$SIS" = ports ]; then
  echo "== $(date "+%d/%m %H:%M") ports $ROM" > /userdata/system/logs/ports.log
  /usr/bin/tos-carregando 4
  ( cd "$(dirname "$ROM")" && HOME=/root bash "$ROM" ) >> /userdata/system/logs/ports.log 2>&1
  /usr/bin/tos-carregando 5
  exec /usr/bin/scrapcade
fi

primeiro() { for c in "$@"; do [ -f "/usr/lib/libretro/${c}_libretro.so" ] && { echo $c; return; }; done; echo $1; }
# Half-Life (Xash3D, como no iChroma): o "jogo" e um .xash com o nome da pasta (valve) dentro de roms/halflife.
# As bibliotecas do jogo da Steam nao servem aqui: copia as do hlsdk-portable para a pasta do usuario.
if [ "$SIS" = halflife ]; then
  HL=/userdata/roms/halflife
  JOGO=$(head -1 "$ROM" | tr -d '\r\n ')
  [ -n "$JOGO" ] || JOGO=valve
  if [ -x /usr/bin/xash3d ] && [ -d "$HL/$JOGO" ]; then
    mkdir -p "$HL/$JOGO/cl_dlls" "$HL/$JOGO/dlls"
    for f in /usr/lib/xash3d/hlsdk/cl_dlls/*.so /usr/lib/xash3d/hlsdk/dlls/*.so; do
      d="$HL/$JOGO/${f#/usr/lib/xash3d/hlsdk/}"
      cmp -s "$f" "$d" || cp "$f" "$d"
    done
    cp /usr/share/tos/xash3d/scrapcade_controle.cfg "$HL/$JOGO/"
    EXTRAS=$(ls /usr/share/xash3d/valve/extras.pk3 /usr/lib/xash3d/valve/extras.pk3 2>/dev/null | head -1)
    echo "== $(date "+%d/%m %H:%M") halflife $JOGO" > /userdata/system/logs/xash3d.log
    INICIO=$(cut -d. -f1 /proc/uptime)
    /usr/bin/tos-carregando 4
    ( cd "$HL" && LD_LIBRARY_PATH=/usr/lib/xash3d XASH3D_BASEDIR="$HL" XASH3D_EXTRAS_PAK1="$EXTRAS" HOME=/userdata/system \
        /usr/bin/xash3d -game "$JOGO" -fullscreen +exec scrapcade_controle.cfg ) >> /userdata/system/logs/xash3d.log 2>&1
    [ $(( $(cut -d. -f1 /proc/uptime) - INICIO )) -lt 4 ] && \
      echo "Esse jogo não abriu. Veja logs/xash3d.log (falta a pasta $JOGO da sua cópia da Steam?)" > /tmp/tos-nao-abriu
  else
    echo "Para jogar, copie a pasta $JOGO do Half-Life (da sua cópia da Steam) para roms/halflife." > /tmp/tos-nao-abriu
  fi
  /usr/bin/tos-carregando 5
  exec /usr/bin/scrapcade
fi

# Xbox (xemu) e PS3 (RPCS3): programas proprios (nao sao nucleos do RetroArch). Abrem numa sessao do X so
# deles; Select + Start (ou Esc segurado) fecha, como nos outros consoles. Os arquivos do console ficam na pasta bios.
if [ "$SIS" = xbox ] || [ "$SIS" = ps3 ]; then
  B=/userdata/bios
  SC=/userdata/system/configs
  export XDG_RUNTIME_DIR=/tmp/xdg-jogo XDG_CACHE_HOME=/tmp/cache-jogo PIPEWIRE_RUNTIME_DIR=/run/pipewire
  mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME"; chmod 700 "$XDG_RUNTIME_DIR"
  LOGX=/userdata/system/logs/$SIS.log
  echo "== $(date "+%d/%m %H:%M") $SIS $ROM" > "$LOGX"
  CLIENTE=/tmp/tos-x-cliente.sh
  FALTA=""
  if [ "$SIS" = xbox ]; then
    [ -f "$B/mcpx_1.0.bin" ] || FALTA="mcpx_1.0.bin"
    [ -f "$B/Complex_4627.bin" ] || FALTA="${FALTA:+$FALTA e }Complex_4627.bin"
    # HD vazio oficial do projeto xemu (sem nada da Microsoft), baixado no primeiro jogo e conferido pelo hash
    if [ -z "$FALTA" ] && [ ! -f "$B/xbox_hdd.qcow2" ]; then
      /usr/bin/tos-carregando 4
      Z=/tmp/xbox_hdd.zip
      curl -fsL -m 120 -o "$Z" https://github.com/xemu-project/xemu-hdd-image/releases/download/1.0/xbox_hdd.qcow2.zip &&
        echo "d9f5a4c1224ff24cf9066067bda70cc8b9c874ea22b9c542eb2edbfc4621bb39  $Z" | sha256sum -c - >/dev/null 2>&1 &&
        unzip -oq "$Z" -d "$B" >> "$LOGX" 2>&1
      rm -f "$Z"
      [ -f "$B/xbox_hdd.qcow2" ] || FALTA="o HD vazio do Xbox (sem internet? ele é baixado no primeiro jogo)"
    fi
    export XDG_DATA_HOME=$SC
    mkdir -p "$SC/xemu/xemu"
    cat > "$SC/xemu/xemu/xemu.toml" <<EOF
[general]
show_welcome = false
[display.window]
fullscreen_on_startup = true
[display.ui]
show_menubar = false
[sys.files]
bootrom_path = '$B/mcpx_1.0.bin'
flashrom_path = '$B/Complex_4627.bin'
eeprom_path = '$SC/xemu/eeprom.bin'
hdd_path = '$B/xbox_hdd.qcow2'
dvd_path = '$ROM'
EOF
    printf '#!/bin/sh\nexec /usr/bin/xemu -full-screen\n' > "$CLIENTE"
    PROG=/usr/lib/xemu
  else
    # PS3: o atalho .ps3 tem o nome da pasta do jogo (PS3_GAME/USRDIR/EBOOT.BIN)
    PASTA="$(dirname "$ROM")/$(head -1 "$ROM" | tr -d '\r')"
    EBOOT="$PASTA/PS3_GAME/USRDIR/EBOOT.BIN"
    [ -f "$EBOOT" ] || EBOOT="$PASTA/USRDIR/EBOOT.BIN"
    export XDG_CONFIG_HOME=$SC
    R3=$SC/rpcs3
    mkdir -p "$R3/input_configs/global"
    if [ ! -d "$R3/dev_flash/vsh/module" ] && [ ! -f "$B/PS3UPDAT.PUP" ]; then FALTA="PS3UPDAT.PUP (firmware oficial, do site da Sony)"; fi
    # controle: o primeiro que o ScrapCade viu (nome do SDL) vira o jogador 1 do RPCS3
    CTRL=$(head -1 /tmp/tos-controle-sdl 2>/dev/null)
    if [ -n "$CTRL" ]; then
      printf 'Player 1 Input:\n  Handler: SDL\n  Device: %s 1\n' "$CTRL" > "$R3/input_configs/global/Default.yml"
    fi
    {
      echo '#!/bin/sh'
      # firmware: instala uma vez, a partir do PS3UPDAT.PUP da pasta bios
      echo "[ -d '$R3/dev_flash/vsh/module' ] || /usr/bin/rpcs3 --installfw '$B/PS3UPDAT.PUP'"
      echo "exec /usr/bin/rpcs3 --no-gui --fullscreen '$EBOOT'"
    } > "$CLIENTE"
    PROG=/usr/lib/rpcs3
  fi
  if [ -n "$FALTA" ]; then
    echo "Para jogar $([ "$SIS" = xbox ] && echo Xbox || echo PS3), falta na pasta bios: $FALTA." > /tmp/tos-nao-abriu
  else
    chmod +x "$CLIENTE"
    INICIO=$(cut -d. -f1 /proc/uptime)
    /usr/bin/tos-carregando 8
    /usr/bin/tos-sair-combo "$PROG" >> "$LOGX" 2>&1 &
    xinit "$CLIENTE" -- /usr/bin/Xorg :0 vt1 -nolisten tcp -keeptty >> "$LOGX" 2>&1
    [ $(( $(cut -d. -f1 /proc/uptime) - INICIO )) -lt 4 ] && echo "Esse jogo não abriu. Veja logs/$SIS.log" > /tmp/tos-nao-abriu
  fi
  /usr/bin/tos-carregando 5
  exec /usr/bin/scrapcade
fi

case "$SIS" in   # o primeiro nucleo instalado (a imagem de 32 bits leva os mais leves)
  nes) CORE=$(primeiro mesen fceumm) ;;
  snes) CORE=$(primeiro snes9x snes9x2010) ;;
  megadrive) CORE=$(primeiro genesis_plus_gx picodrive) ;;
  gb|gbc) CORE=gambatte ;;
  gba) CORE=$(primeiro mgba gpsp) ;;
  psx) CORE=pcsx_rearmed ;;
  n64) CORE=mupen64plus_next ;;
  arcade|neogeo) CORE=fbneo ;;
  psp) CORE=ppsspp ;;
  nds) CORE=melonds ;;
  saturn) CORE=mednafen_saturn ;;
  dreamcast) CORE=flycast ;;
  doom) CORE=prboom ;;
  dos) CORE=dosbox_pure ;;
  # Game Gear e SG-1000: a imagem de 32 bits nao tem o Genesis Plus GX; o PicoDrive dela roda os dois
  mastersystem|segacd|gamegear|sg1000) CORE=$(primeiro genesis_plus_gx picodrive) ;;
  atari5200) CORE=a5200 ;;
  jaguar) CORE=virtualjaguar ;;
  colecovision) CORE=gearcoleco ;;
  intellivision) CORE=freeintv ;;
  odyssey2) CORE=o2em ;;
  vectrex) CORE=vecx ;;
  3do) CORE=opera ;;
  neogeocd) CORE=neocd ;;
  msx) CORE=bluemsx ;;
  c64) CORE=vice_x64 ;;
  amiga) CORE=puae ;;
  atarist) CORE=hatari ;;
  scummvm) CORE=scummvm ;;
  easyrpg) CORE=easyrpg ;;
  sega32x) CORE=picodrive ;;
  pcengine) CORE=mednafen_pce_fast ;;
  atari2600) CORE=stella2014 ;;
  atari7800) CORE=prosystem ;;
  lynx) CORE=handy ;;
  ngp) CORE=mednafen_ngp ;;
  wswan) CORE=mednafen_wswan ;;
  virtualboy) CORE=mednafen_vb ;;
  ps2) CORE=pcsx2 ;;
  gamecube|wii) CORE=dolphin ;;
  3ds) CORE=citra ;;
  quake) CORE=tyrquake ;;
  cavestory) CORE=nxengine ;;
  *) CORE="" ;;
esac
# o ScrapCade pode mandar o nucleo escolhido pelo usuario (ex.: bsnes no lugar do snes9x)
[ -n "$3" ] && [ -f "/usr/lib/libretro/$3_libretro.so" ] && CORE=$3
SO=/usr/lib/libretro/${CORE}_libretro.so
# Quake e Cave Story: o "jogo" e um atalho (.quake, .cavestory) com o caminho do arquivo de verdade na primeira linha
case "$SIS" in quake|cavestory) R=$(head -1 "$ROM" | tr -d '\r'); [ -n "$R" ] && ROM="$(dirname "$ROM")/$R" ;; esac
# ScummVM e RPG Maker: o atalho (.scummvm, .easyrpg) tem o nome da pasta do jogo. O ScummVM reconhece o jogo
# sozinho pela pasta quando recebe um arquivo dela; o EasyRPG abre o RPG_RT.ldb.
case "$SIS" in scummvm|easyrpg)
  PASTA="$(dirname "$ROM")/$(head -1 "$ROM" | tr -d '\r')"
  if [ -d "$PASTA" ]; then
    if [ "$SIS" = easyrpg ]; then A=$(ls "$PASTA" | grep -i '^rpg_rt\.ldb$' | head -1)
    else A=$(ls "$PASTA" | grep -iv '\.scummvm$' | while read -r f; do [ -f "$PASTA/$f" ] && { echo "$f"; break; }; done); fi
    [ -n "$A" ] && ROM="$PASTA/$A"
  fi ;;
esac
# dados dos nucleos novos da v0.22 na pasta de BIOS (copia uma vez)
[ "$CORE" = bluemsx ] && [ ! -d /userdata/bios/Machines ] && cp -r /usr/share/retroarch/system/Databases /usr/share/retroarch/system/Machines /userdata/bios/
[ "$CORE" = puae ] && [ ! -d /userdata/bios/uae_data ] && cp -r /usr/share/retroarch/system/uae_data /userdata/bios/
[ "$CORE" = scummvm ] && [ ! -d /userdata/bios/scummvm ] && cp -r /usr/share/retroarch/system/scummvm /userdata/bios/
# Atari ST sem o TOS original: o EmuTOS livre no lugar
[ "$CORE" = hatari ] && [ ! -f /userdata/bios/tos.img ] && cp /usr/share/tos/emutos/tos.img /userdata/bios/tos.img
# Dolphin e PCSX2 precisam dos arquivos deles (Sys, GameIndex) na pasta de BIOS (copia uma vez)
[ "$CORE" = dolphin ] && [ ! -d /userdata/bios/dolphin-emu/Sys ] && mkdir -p /userdata/bios/dolphin-emu && cp -r /usr/share/tos/dolphin-emu/Sys /userdata/bios/dolphin-emu/
[ "$CORE" = pcsx2 ] && [ ! -f /userdata/bios/pcsx2/resources/GameIndex.yaml ] && mkdir -p /userdata/bios/pcsx2/bios && cp -r /usr/share/tos/pcsx2/resources /userdata/bios/pcsx2/
# o NXEngine precisa dos dados livres dele (fontes, sons) na pasta de BIOS
[ "$CORE" = nxengine ] && [ ! -d /userdata/bios/nxengine ] && cp -r /usr/share/retroarch/system/nxengine /userdata/bios/nxengine
# o PrBoom precisa do prboom.wad dele na pasta de BIOS
[ "$CORE" = prboom ] && [ ! -f /userdata/bios/prboom.wad ] && cp /usr/share/tos/prboom.wad /userdata/bios/
# o PPSSPP precisa das fontes e imagens dele na pasta de BIOS (copia uma vez: o exFAT nao tem atalhos)
[ "$CORE" = ppsspp ] && [ ! -d /userdata/bios/PPSSPP ] && cp -r /usr/share/tos/ppsspp /userdata/bios/PPSSPP

if [ -n "$CORE" ] && [ -f "$SO" ] && [ -f "$ROM" ]; then
  # configuracao central: sempre o modelo do sistema; o que o usuario quiser mudar vai em retroarch-usuario.cfg
  cp /usr/share/tos/retroarch.cfg "$CFG/retroarch.cfg"
  # saves do perfil que esta jogando: o perfil 1 usa os que ja existiam; os outros tem pasta propria
  PID=$(cut -d'|' -f1 /tmp/tos-perfil 2>/dev/null)
  SAVES="/userdata/saves/$SIS"
  [ -n "$PID" ] && [ "$PID" != 1 ] && SAVES="/userdata/saves/$SIS/perfil-$PID"
  mkdir -p "$SAVES"
  {
    echo "savefile_directory = \"$SAVES\""
    echo "savestate_directory = \"$SAVES\""
  } > /tmp/tos-console.cfg
  EXTRA=/tmp/tos-console.cfg
  # o que foi escolhido no painel Sistema > JOGANDO (voltar de onde parou, filtro, proporcao, atraso, FPS)
  SET=""
  if [ -f "$CFG/scrapcade-jogo.cfg" ]; then
    EXTRA="$EXTRA|$CFG/scrapcade-jogo.cfg"
    SHADER=$(sed -n 's/^video_shader = "\(.*\)"/\1/p' "$CFG/scrapcade-jogo.cfg")
    [ -n "$SHADER" ] && [ -f "$SHADER" ] && SET="--set-shader $SHADER"
  fi
  # filtro escolhido so para este console (painel: Filtro do <console>); vem depois do filtro geral
  SC=/userdata/system/configs
  : > /tmp/tos-console2.cfg
  if [ -f "$SC/shaders/$SIS" ]; then
    S=$(head -1 "$SC/shaders/$SIS")
    case "$S" in
      nenhum) printf 'video_shader_enable = "false"\nvideo_smooth = "false"\n' >> /tmp/tos-console2.cfg; SET="" ;;
      liso) printf 'video_shader_enable = "false"\nvideo_smooth = "true"\n' >> /tmp/tos-console2.cfg; SET="" ;;
      *) [ -f "$S" ] && { echo 'video_shader_enable = "true"' >> /tmp/tos-console2.cfg; SET="--set-shader $S"; } ;;
    esac
  fi
  # moldura nos consoles de mesa (imagem 4:3): a do formato da tela (16:9, 16:10 ou 5:4)
  if [ -f "$SC/moldura" ]; then
    case "$SIS" in gb|gbc|gba|nds|3ds|psp|gamegear|lynx|ngp|wswan|virtualboy|ports|doom|quake|cavestory|dos|halflife) ;; *)
      T=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null); W=${T%,*}; H=${T#*,}; M=169
      [ -n "$H" ] && [ "$H" -gt 0 ] && { R=$(( W * 100 / H )); [ $R -lt 170 ] && M=1610; [ $R -lt 140 ] && M=54; [ $R -lt 130 ] && M=""; }
      [ -n "$M" ] && printf 'input_overlay_enable = "true"\ninput_overlay = "/usr/share/tos/molduras/moldura-%s.cfg"\ninput_overlay_opacity = "1.000000"\ninput_overlay_hide_in_menu = "true"\naspect_ratio_index = "0"\nvideo_scale_integer = "false"\n' "$M" >> /tmp/tos-console2.cfg ;;
    esac
  fi
  EXTRA="$EXTRA|/tmp/tos-console2.cfg"
  # jogar online: hospedar ou entrar no IP do amigo (painel: Jogar online)
  if [ -f "$SC/online" ]; then
    read -r MODO IP < "$SC/online"
    NOME=$(cut -d'|' -f2 /tmp/tos-perfil 2>/dev/null)
    [ -n "$NOME" ] && echo "netplay_nickname = \"$NOME\"" >> /tmp/tos-console2.cfg
    [ "$MODO" = host ] && SET="$SET --host"
    [ "$MODO" = connect ] && [ -n "$IP" ] && SET="$SET --connect $IP"
  fi
  # conquistas (painel: RetroAchievements com a conta do usuario)
  [ -f "$SC/conquistas.cfg" ] && EXTRA="$EXTRA|$SC/conquistas.cfg"
  [ -f "$CFG/retroarch-usuario.cfg" ] && EXTRA="$EXTRA|$CFG/retroarch-usuario.cfg"
  # N64 em placa de video sem OpenGL 3.3 (Intel antigas, GMA): o GLideN64 nao abre. Neste PC o desenho e pelo
  # processador (angrylion): mais lento, mas abre em qualquer placa. A marca fica guardada para as proximas vezes.
  N64SW=/userdata/system/configs/n64-software
  n64_software() {
    printf 'mupen64plus-rdp-plugin = "angrylion"\nmupen64plus-rsp-plugin = "hle"\n' > /tmp/tos-n64.opt
    echo "core_options_path = \"/tmp/tos-n64.opt\"" >> /tmp/tos-console.cfg
  }
  [ "$CORE" = mupen64plus_next ] && [ -f "$N64SW" ] && n64_software
  echo "== $(date "+%d/%m %H:%M") $SIS $CORE $ROM" > /userdata/system/logs/retroarch.log
  abre() {
    INICIO=$(cut -d. -f1 /proc/uptime)
    /usr/bin/tos-carregando 8     # logo + CARREGANDO na tela ate o emulador aparecer (nada de terminal)
    retroarch --verbose --config "$CFG/retroarch.cfg" --appendconfig "$EXTRA" $SET -L "$SO" "$ROM" \
      >> /userdata/system/logs/retroarch.log 2>&1 &
    RA=$!
    sleep 3; /usr/bin/tos-carregando para   # o emulador ja tem a tela: a animacao para de gastar processador
    wait $RA
  }
  abre
  # so troca se o motivo foi a placa de video (erro de OpenGL/contexto no registro), nao uma ROM com defeito
  if [ "$CORE" = mupen64plus_next ] && [ ! -f "$N64SW" ] && [ $(( $(cut -d. -f1 /proc/uptime) - INICIO )) -lt 4 ] &&
     grep -qiE "opengl|egl|glsl|gl context|hw context|hw render|gliden" /userdata/system/logs/retroarch.log; then
    echo "== nao abriu com o GLideN64: tentando de novo com o desenho pelo processador (angrylion)" >> /userdata/system/logs/retroarch.log
    touch "$N64SW"; n64_software; abre
  fi
  # fechou em menos de 4 s: o jogo nao abriu (arquivo com defeito, versao errada, falta BIOS). Avisa o ScrapCade
  if [ $(( $(cut -d. -f1 /proc/uptime) - INICIO )) -lt 4 ]; then
    MOTIVO=$(grep -i "\[error\]" /userdata/system/logs/retroarch.log | tail -1 | sed 's/.*\[[Ee][Rr][Rr][Oo][Rr]\] *//; s/^\[[^]]*\] *//; s/\.*$//' | cut -c1-90)
    echo "Esse jogo não abriu${MOTIVO:+: $MOTIVO}. Veja logs/retroarch.log" > /tmp/tos-nao-abriu
  fi
elif [ -f "$ROM" ]; then
  echo "Ainda não há emulador para esse console nesta versão do ScrapCade OS." > /tmp/tos-nao-abriu
fi
/usr/bin/tos-carregando 5     # na volta, a mesma tela ate o menu desenhar
exec /usr/bin/scrapcade
