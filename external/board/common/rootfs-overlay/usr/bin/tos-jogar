#!/bin/sh
# ScrapCade: abre o jogo no emulador certo, com a configuracao central, e volta para o ScrapCade.
# Uso: tos-jogar <console> <arquivo do jogo>
export HOME=/userdata/system   # historico e favoritos do RetroArch ficam em SCRAP-DADOS
SIS=$1
ROM=$2
CFG=/userdata/system/configs/retroarch
mkdir -p "$CFG" "/userdata/saves/$SIS" /userdata/bios /userdata/screenshots /userdata/system/logs

# Ports (PortMaster): o "jogo" e um script bash; roda ele e volta para o ScrapCade
if [ "$SIS" = ports ]; then
  echo "== $(date "+%d/%m %H:%M") ports $ROM" > /userdata/system/logs/ports.log
  ( cd "$(dirname "$ROM")" && HOME=/root bash "$ROM" ) >> /userdata/system/logs/ports.log 2>&1
  exec /usr/bin/scrapcade
fi

primeiro() { for c in "$@"; do [ -f "/usr/lib/libretro/${c}_libretro.so" ] && { echo $c; return; }; done; echo $1; }
case "$SIS" in   # o primeiro nucleo instalado (a imagem de 32 bits leva os mais leves)
  nes) CORE=$(primeiro mesen fceumm) ;;
  snes) CORE=$(primeiro snes9x snes9x2010) ;;
  megadrive) CORE=$(primeiro genesis_plus_gx picodrive) ;;
  gb|gbc) CORE=gambatte ;;
  gba) CORE=$(primeiro mgba gpsp) ;;
  psx) CORE=pcsx_rearmed ;;
  n64) CORE=mupen64plus_next ;;
  arcade|neogeo) CORE=fbneo ;;
  psp) CORE=ppsspp ;;
  nds) CORE=melonds ;;
  saturn) CORE=mednafen_saturn ;;
  dreamcast) CORE=flycast ;;
  doom) CORE=prboom ;;
  *) CORE="" ;;
esac
# o ScrapCade pode mandar o nucleo escolhido pelo usuario (ex.: bsnes no lugar do snes9x)
[ -n "$3" ] && [ -f "/usr/lib/libretro/$3_libretro.so" ] && CORE=$3
SO=/usr/lib/libretro/${CORE}_libretro.so
# o PrBoom precisa do prboom.wad dele na pasta de BIOS
[ "$CORE" = prboom ] && [ ! -f /userdata/bios/prboom.wad ] && cp /usr/share/tos/prboom.wad /userdata/bios/
# o PPSSPP precisa das fontes e imagens dele na pasta de BIOS (copia uma vez: o exFAT nao tem atalhos)
[ "$CORE" = ppsspp ] && [ ! -d /userdata/bios/PPSSPP ] && cp -r /usr/share/tos/ppsspp /userdata/bios/PPSSPP

if [ -n "$CORE" ] && [ -f "$SO" ] && [ -f "$ROM" ]; then
  # configuracao central: sempre o modelo do sistema; o que o usuario quiser mudar vai em retroarch-usuario.cfg
  cp /usr/share/tos/retroarch.cfg "$CFG/retroarch.cfg"
  # saves do perfil que esta jogando: o perfil 1 usa os que ja existiam; os outros tem pasta propria
  PID=$(cut -d'|' -f1 /tmp/tos-perfil 2>/dev/null)
  SAVES="/userdata/saves/$SIS"
  [ -n "$PID" ] && [ "$PID" != 1 ] && SAVES="/userdata/saves/$SIS/perfil-$PID"
  mkdir -p "$SAVES"
  {
    echo "savefile_directory = \"$SAVES\""
    echo "savestate_directory = \"$SAVES\""
  } > /tmp/tos-console.cfg
  EXTRA=/tmp/tos-console.cfg
  # o que foi escolhido no painel Sistema > JOGANDO (voltar de onde parou, filtro, proporcao, atraso, FPS)
  SET=""
  if [ -f "$CFG/scrapcade-jogo.cfg" ]; then
    EXTRA="$EXTRA|$CFG/scrapcade-jogo.cfg"
    SHADER=$(sed -n 's/^video_shader = "\(.*\)"/\1/p' "$CFG/scrapcade-jogo.cfg")
    [ -n "$SHADER" ] && [ -f "$SHADER" ] && SET="--set-shader $SHADER"
  fi
  [ -f "$CFG/retroarch-usuario.cfg" ] && EXTRA="$EXTRA|$CFG/retroarch-usuario.cfg"
  echo "== $(date "+%d/%m %H:%M") $SIS $CORE $ROM" > /userdata/system/logs/retroarch.log
  INICIO=$(cut -d. -f1 /proc/uptime)
  retroarch --verbose --config "$CFG/retroarch.cfg" --appendconfig "$EXTRA" $SET -L "$SO" "$ROM" \
    >> /userdata/system/logs/retroarch.log 2>&1
  # fechou em menos de 4 s: o jogo nao abriu (arquivo com defeito, versao errada, falta BIOS). Avisa o ScrapCade
  if [ $(( $(cut -d. -f1 /proc/uptime) - INICIO )) -lt 4 ]; then
    MOTIVO=$(grep -i "\[error\]" /userdata/system/logs/retroarch.log | tail -1 | sed 's/.*\[[Ee][Rr][Rr][Oo][Rr]\] *//; s/^\[[^]]*\] *//; s/\.*$//' | cut -c1-90)
    echo "Esse jogo não abriu${MOTIVO:+: $MOTIVO}. Veja logs/retroarch.log" > /tmp/tos-nao-abriu
  fi
elif [ -f "$ROM" ]; then
  echo "Ainda não há emulador para esse console nesta versão do ScrapCade OS." > /tmp/tos-nao-abriu
fi
exec /usr/bin/scrapcade
