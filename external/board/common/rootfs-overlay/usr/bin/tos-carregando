#!/bin/sh
# ScrapCade OS: tela de carregamento entre o menu e os jogos, desenhada direto na tela (/dev/fb0), para nunca
# aparecer o terminal: fundo preto, a logo e o "CARREGANDO..." com o anel de blocos girando (o mesmo do menu).
#   tos-carregando [segundos]   desenha e anima por ate N segundos (padrao 6); "tos-carregando para" encerra
# Os quadros vem de /usr/share/tos/carregando (gera_carregando_raw.py). Sem /dev/fb0 ou com "loglevel=7" no boot,
# nao faz nada.
D=/usr/share/tos/carregando
PID=/tmp/tos-carregando.pid
para() { [ -f $PID ] && kill "$(cat $PID)" 2>/dev/null; rm -f $PID; }
[ "$1" = para ] && { para; exit 0; }
grep -q "loglevel=7" /proc/cmdline && exit 0
f=/sys/class/graphics/fb0
[ -c /dev/fb0 ] && [ -r $f/bits_per_pixel ] || exit 0
bpp=$(cat $f/bits_per_pixel); [ -f $D/logo$bpp.raw ] && [ -f $D/carregando$bpp.raw ] || exit 0
seg=${1:-6}
m=$(head -1 $f/modes 2>/dev/null | sed -n 's/.*:\([0-9]*\)x\([0-9]*\).*/\1 \2/p')   # o tamanho visivel
[ -n "$m" ] || m=$(tr ',' ' ' < $f/virtual_size)
set -- $m; w=$1; h=$2; st=$(cat $f/stride); bypp=$((bpp / 8))
lw=480; lh=64; cw=445; ch=72
[ "$w" -ge $lw ] && [ "$h" -ge $((lh + ch + 60)) ] || exit 0
pinta() {   # arquivo, byte inicial, bytes por linha, linhas, bytes entre linhas no arquivo, x e y na tela
  i=0
  while [ $i -lt $4 ]; do
    dd if=$1 of=/dev/fb0 bs=$3 count=1 skip=$(($2 + i * $5)) seek=$(( ($7 + i) * st + $6 * bypp )) \
       iflag=skip_bytes oflag=seek_bytes conv=notrunc 2>/dev/null
    i=$((i + 1))
  done
}
para
printf '\033c\033[?25l' > /dev/tty1 2>/dev/null            # o terminal por baixo fica limpo e sem cursor
dd if=/dev/zero of=/dev/fb0 bs=$st count=$h 2>/dev/null      # tela preta
x0=$(( (w - lw) / 2 )); y0=$(( (h - lh - ch - 40) / 2 ))
cx=$(( (w - cw) / 2 )); cy=$((y0 + lh + 40))
pinta $D/logo$bpp.raw 0 $((lw * bypp)) $lh $((lw * bypp)) $x0 $y0
pinta $D/carregando$bpp.raw $((7 * ch * cw * bypp)) $((cw * bypp)) $ch $((cw * bypp)) $cx $cy   # texto com os 3 pontinhos
(
  # so o anel (56 x 56 a partir de 8,8 em cada quadro) muda: menos trabalho para o processador enquanto o jogo carrega
  q=0; fim=$(( $(cut -d. -f1 /proc/uptime) + seg ))
  while [ "$(cut -d. -f1 /proc/uptime)" -lt $fim ]; do
    pinta $D/carregando$bpp.raw $(( (q * ch + 8) * cw * bypp + 8 * bypp )) $((56 * bypp)) 56 $((cw * bypp)) $((cx + 8)) $((cy + 8))
    q=$(( (q + 1) % 8 )); sleep 0.12
  done
  rm -f $PID
) &
echo $! > $PID
exit 0
