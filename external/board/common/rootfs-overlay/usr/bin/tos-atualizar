#!/bin/sh
# ScrapCade: atualizacao segura A/B pelas GitHub Releases do projeto.
#   tos-atualizar verificar  -> "atual|nova|MB" com as versoes SemVer (nova vazia = ja esta em dia; "erro" = sem internet)
#   tos-atualizar instalar   -> baixa, confere o SHA-256 e troca; a versao de agora vira a "anterior"
#   tos-atualizar confirmar  -> a versao nova ligou bem (o ScrapCade chama): nao volta mais sozinha
# Progresso em /tmp/tos-atualizar.txt ("porcentagem mensagem"), mostrado no painel Sistema.
REPO=thiagotechmaker/scrapcade.os
API=https://api.github.com/repos/$REPO/releases/latest
P=/tmp/tos-atualizar.txt
D=/boot/boot
[ -f $D/tos-servidor-teste ] && API=$(cat $D/tos-servidor-teste)   # so para testes (servidor falso)
p() { echo "$1 $2" > $P; }
atual() { sed -n 's/^BUILD_ID=//p' /etc/os-release; }   # numero da compilacao (ano mes dia hora minuto)
rotulo() { v=$(sed -n 's/^VERSION="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release); echo "${v:-$(atual)}"; }
# PC de 32 bits: a versao publicada traz os arquivos com -32 no nome (tos-32.squashfs, bzImage-32, initrd-32.gz)
case "$(uname -m)" in i?86) X=-32 ;; *) X= ;; esac
SQ=tos$X.squashfs; BZ=bzImage$X; IR=initrd$X.gz; SUMS=SHA256SUMS$X

info() {   # baixa a descricao da ultima versao publicada (404 = nenhuma versao publicada ainda: conta como em dia)
  c=$(curl -sSL -m 20 -H "Accept: application/vnd.github+json" "$API" -o /tmp/tos-release.json -w '%{http_code}' 2>/dev/null)
  [ "$c" = 404 ] && : > /tmp/tos-release.json
  [ "$c" = 200 ] || [ "$c" = 404 ]
}
asset() {   # endereco de download de um arquivo da versao
  grep -o "\"browser_download_url\": *\"[^\"]*/$1\"" /tmp/tos-release.json | sed 's/.*"\(http[^"]*\)"/\1/'
}
tag() { sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' /tmp/tos-release.json | head -1; }
nova() {   # numero da compilacao da versao publicada: o arquivo BUILD_ID da versao (tags antigas: o proprio "v<BUILD_ID>")
  t=$(tag)
  case "$t" in [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) echo "$t"; return ;; esac
  u=$(asset BUILD_ID)
  [ -n "$u" ] && curl -fsSL -m 20 "$u" 2>/dev/null | tr -dc 0-9 | head -c 12
}

case "$1" in
  verificar)
    [ -d /tmp/tos-atualizar.trava ] && { echo "$(rotulo)|baixando|0"; exit 0; }   # baixando em segundo plano
    info || { echo "$(rotulo)|erro|0"; exit 0; }
    n=$(nova)
    # ja baixada (falta reiniciar): nao baixa de novo
    [ -n "$n" ] && [ -f $D/tos-testando ] && [ "$(cat $D/tos-nova-versao 2>/dev/null)" = "$n" ] && { echo "$(rotulo)|pronta|0"; exit 0; }
    tam=$(grep -o "\"name\": *\"$SQ\"[^}]*\"size\": *[0-9]*" /tmp/tos-release.json | sed 's/.*"size": *//')
    if [ -n "$n" ] && [ "$n" -gt "$(atual)" ] 2>/dev/null; then echo "$(rotulo)|$(tag)|$(( ${tam:-0} / 1048576 ))"
    else echo "$(rotulo)||0"; fi
    ;;
  instalar)
    # uma atualizacao por vez (a automatica em segundo plano e a do painel nao podem baixar juntas)
    mkdir /tmp/tos-atualizar.trava 2>/dev/null || { p 0 "ERRO: a versão nova já está sendo baixada"; exit 1; }
    trap 'rmdir /tmp/tos-atualizar.trava 2>/dev/null' EXIT
    grep -q " /boot vfat" /proc/mounts || { p 0 "ERRO: este ScrapCade roda de um .iso ou DVD: grave a imagem nova no pen drive"; exit 1; }
    p 2 "Procurando a versão nova"
    info || { p 0 "ERRO: sem internet"; exit 1; }
    n=$(nova)
    tam=$(grep -o "\"name\": *\"$SQ\"[^}]*\"size\": *[0-9]*" /tmp/tos-release.json | sed 's/.*"size": *//')
    [ -n "$n" ] && [ "$n" -gt "$(atual)" ] || { p 0 "ERRO: já está na versão mais nova"; exit 1; }
    [ -f $D/tos-testando ] && [ "$(cat $D/tos-nova-versao 2>/dev/null)" = "$n" ] && { p 100 "Pronto! A versão nova já foi baixada: reinicie para usar."; exit 0; }
    mount -o remount,rw /boot || { p 0 "ERRO: não consegui gravar no pen drive"; exit 1; }
    # a versao de agora vai virar a "anterior": a anterior velha e as com problema saem antes, para caber
    rm -f $D/tos-anterior.squashfs $D/bzImage-anterior $D/initrd-anterior.gz           $D/tos-com-problema.squashfs $D/bzImage-com-problema $D/initrd-com-problema.gz
    precisa=$(( ${tam:-0} / 1048576 + 40 ))
    livre=$(df -m $D | awk 'NR==2 {print $4}')
    [ "${livre:-0}" -ge "$precisa" ] || { mount -o remount,ro /boot; p 0 "ERRO: falta espaço no pen drive (precisa de $precisa MB, tem $livre MB)"; exit 1; }
    T=$D/novo
    rm -rf $T; mkdir -p $T
    i=0
    for f in $SQ $BZ $IR $SUMS; do
      i=$((i + 1))
      p $((5 + i * 20)) "Baixando $f"
      u=$(asset $f)
      [ -n "$u" ] && curl -fsSL -m 3600 "$u" -o $T/$f || { rm -rf $T; mount -o remount,ro /boot; p 0 "ERRO: download de $f falhou"; exit 1; }
    done
    p 88 "Conferindo os arquivos (SHA-256)"
    ( cd $T && grep -E " ($SQ|$BZ|$IR)$" $SUMS | sha256sum -c - >/dev/null 2>&1 ) \
      || { rm -rf $T; mount -o remount,ro /boot; p 0 "ERRO: os arquivos baixados não conferem; nada foi trocado"; exit 1; }
    # no pen drive os nomes sao sempre os mesmos (o boot nao muda com a arquitetura)
    [ -n "$X" ] && { mv $T/$SQ $T/tos.squashfs; mv $T/$BZ $T/bzImage; mv $T/$IR $T/initrd.gz; }
    p 94 "Trocando (a versão de agora fica guardada como anterior)"
    cd $D
    mv tos.squashfs tos-anterior.squashfs
    mv bzImage bzImage-anterior
    mv initrd.gz initrd-anterior.gz
    mv $T/tos.squashfs $T/bzImage $T/initrd.gz .
    rm -rf $T tos-com-problema.squashfs bzImage-com-problema initrd-com-problema.gz
    echo 0 > tos-testando
    echo "$n" > tos-nova-versao   # qual versao esta esperando o reinicio
    sync
    mount -o remount,ro /boot
    p 100 "Pronto! Reinicie para usar a versão nova."
    ;;
  confirmar)
    [ -f $D/tos-testando ] || exit 0
    grep -q "tos.sistema=" /proc/cmdline && exit 0   # ligado pela versao anterior: a nova continua em teste
    # a nova foi baixada mas o computador ainda nao reiniciou: o initrd so conta as tentativas de ligar a nova
    # (0 = baixada, ainda nao ligou). Quem esta rodando e a velha: nao confirma.
    [ "$(cat $D/tos-testando 2>/dev/null)" = 0 ] && exit 0
    mount -o remount,rw /boot && rm -f $D/tos-testando $D/tos-nova-versao && sync && mount -o remount,ro /boot
    ;;
esac
exit 0
