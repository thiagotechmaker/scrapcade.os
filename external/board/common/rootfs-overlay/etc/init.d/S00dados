#!/bin/sh
# ScrapCade: particao de dados SCRAP-DADOS (exFAT): jogos, BIOS, saves, temas e configuracoes.
# Se nao existir, e criada no espaco livre do disco do sistema (no primeiro boot). Atualizar o ScrapCade OS
# troca so o tos.squashfs da particao SCRAPCADE: a SCRAP-DADOS nunca e mexida.
msg() { echo "$1" > /dev/console; }

# SCRAP-DADOS; os pen drives gravados antes da troca de nome usam TOS-DADOS e continuam valendo
dados() { blkid | sed -n 's/^\([^:]*\):.*LABEL="\(SCRAP-DADOS\|TOS-DADOS\)".*/\1/p' | head -1; }

criar() {
  boot=$(cat /run-tos-boot 2>/dev/null)
  case "$boot" in /dev/sr*|"") return 1 ;; esac            # DVD ou .iso: nao da para criar
  part=${boot##*/}
  [ -e /sys/class/block/$part/partition ] || return 1      # .iso gravado direto: sem tabela de particoes
  disco=$(basename "$(readlink -f /sys/class/block/$part/..)")
  dev=/dev/$disco
  grep -q " /boot vfat" /proc/mounts || return 1           # o .iso (iso9660) nao ganha particao
  tipo=$(sfdisk -d "$dev" 2>/dev/null | sed -n 's/^label: *//p')
  # GPT gravado num disco maior: leva a copia da tabela para o fim do disco de verdade
  [ "$tipo" = gpt ] && sfdisk --relocate gpt-bak-std "$dev" >/dev/null 2>&1
  livre=$(sfdisk -F "$dev" 2>/dev/null | sed -n 's/.* \([0-9]*\) bytes.*/\1/p' | head -1)
  [ -n "$livre" ] && [ "$livre" -gt 1073741824 ] || return 1   # menos de 1 GB livre: deixa quieto
  msg "ScrapCade: criando a particao de dados (SCRAP-DADOS) no espaco livre do disco..."
  if [ "$tipo" = gpt ]; then novotipo=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7; else novotipo=7; fi
  echo ",,$novotipo" | sfdisk --append --no-reread "$dev" >/dev/null 2>&1 || return 1
  n=$(sfdisk -l "$dev" 2>/dev/null | grep -c "^$dev")
  partx -a --nr "$n" "$dev" 2>/dev/null || partx -u "$dev" 2>/dev/null || true
  sleep 1
  case "$disco" in nvme*|mmcblk*|loop*) novo=${dev}p$n ;; *) novo=$dev$n ;; esac
  [ -b "$novo" ] || return 1
  mkfs.exfat -L SCRAP-DADOS "$novo" >/dev/null 2>&1 || return 1
  msg "ScrapCade: particao de dados pronta."
}

case "$1" in
  start)
    mkdir -p /userdata
    # primeiro boot de um .iso gravado no pen drive: o sistema ja esta na memoria; arruma o pen drive
    if [ -f /run-tos-converter ]; then
      dev=$(cat /run-tos-converter); rm -f /run-tos-converter
      msg "ScrapCade: arrumando o pen drive (so no primeiro boot, leva alguns minutos; nao desligue)..."
      if /usr/bin/tos-instalar "$dev" converter >/dev/null 2>&1; then
        msg "ScrapCade: pen drive pronto: sistema + particao de dados SCRAP-DADOS."
      else
        msg "ScrapCade: nao deu para arrumar o pen drive ($(cut -d' ' -f2- /tmp/tos-instalar.txt)); os jogos ficam na memoria."
      fi
    fi
    d=$(dados)
    [ -z "$d" ] && criar && d=$(dados)
    if [ -n "$d" ] && mount "$d" /userdata 2>/dev/null; then
      :
    elif grep -q " /boot vfat" /proc/mounts && mount -o remount,rw /boot 2>/dev/null; then
      # gravado pelo modo ISO do Rufus (sem espaco para particao): os dados ficam numa pasta do proprio pen drive
      mkdir -p /boot/tos-dados
      mount --bind /boot/tos-dados /userdata
      msg "ScrapCade: jogos e saves na pasta tos-dados do pen drive."
    else
      mount -t tmpfs -o size=60% tmpfs /userdata
      msg "ScrapCade: sem particao de dados; os jogos ficam na memoria ate desligar."
    fi
    mkdir -p /userdata/roms /userdata/bios /userdata/saves /userdata/themes "/userdata/Jogos novos" \
             /userdata/system/logs /userdata/system/connman
    # configuracoes que precisam sobreviver ao desligar (o sistema e somente leitura)
    mkdir -p /var/lib/connman
    mount --bind /userdata/system/connman /var/lib/connman
    # controles Bluetooth pareados continuam pareados depois de desligar
    mkdir -p /userdata/system/bluetooth /var/lib/bluetooth
    mount --bind /userdata/system/bluetooth /var/lib/bluetooth
    ;;
esac
exit 0
