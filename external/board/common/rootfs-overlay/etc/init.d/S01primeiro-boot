#!/bin/sh
# ScrapCade: senha do administrador (root). A imagem nao traz senha fixa (seria a mesma em todo aparelho), e o boot
# nao pede nada: o administrador fica bloqueado ate a senha ser criada no painel Sistema, ao ligar o SSH (e so ele
# e o login de manutencao no tty2 usam essa senha). A senha fica em SCRAP-DADOS (o sistema e somente leitura).
SALVA=/userdata/system/shadow
case "$1" in
  start)
    [ -f "$SALVA" ] && cp "$SALVA" /etc/shadow
    grep -q '^root::' /etc/shadow && passwd -l root >/dev/null 2>&1
    ;;
esac
exit 0
