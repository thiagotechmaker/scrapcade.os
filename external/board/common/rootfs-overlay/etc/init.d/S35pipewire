#!/bin/sh
# ScrapCade: PipeWire + WirePlumber (som, fones e caixas Bluetooth). Os emuladores continuam usando o ALSA,
# que passa a tocar pelo PipeWire. Se o PipeWire nao subir, apaga o /etc/asound.conf e o som vai direto.
export XDG_RUNTIME_DIR=/run/pipewire PIPEWIRE_RUNTIME_DIR=/run/pipewire
case "$1" in
  start)
    mkdir -p $XDG_RUNTIME_DIR; chmod 700 $XDG_RUNTIME_DIR
    start-stop-daemon -S -q -b -m -p /var/run/pipewire.pid -x /usr/bin/pipewire
    sleep 1
    start-stop-daemon -S -q -b -m -p /var/run/wireplumber.pid -x /usr/bin/wireplumber
    for i in 1 2 3 4 5; do [ -S $XDG_RUNTIME_DIR/pipewire-0 ] && break; sleep 1; done
    if [ -S $XDG_RUNTIME_DIR/pipewire-0 ] && [ -f /usr/share/alsa/alsa.conf.d/50-pipewire.conf ]; then
      printf 'pcm.!default { type pipewire }\nctl.!default { type pipewire }\n' > /etc/asound.conf
    else
      # sem PipeWire: o som vai direto para a placa (tira tambem o padrao que o pacote do PipeWire instala)
      rm -f /etc/asound.conf /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf
    fi
    ;;
  stop)
    start-stop-daemon -K -q -p /var/run/wireplumber.pid; start-stop-daemon -K -q -p /var/run/pipewire.pid
    rm -f /etc/asound.conf
    ;;
esac
exit 0
